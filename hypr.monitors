monitorv2 {
  output = DP-2
  mode = 1920x1080@240
  position = 0x0
  scale = 1
  transform = 0
}
monitorv2{
  output = HDMI-A-1
  mode = 3840x2160@60
  position = -960x-2160
  scale = 1
  transform = 0
}
