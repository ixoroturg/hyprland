decoration {
  # скругление 
  rounding = 5
  rounding_power = 2.0

  active_opacity = 0.95
  inactive_opacity = 0.8
  fullscreen_opacity = 1.0

  # затемнение родителя при появлении модального окна
  dim_modal = true
  dim_inactive = false

  dim_strength = 0.5

  # затемнение для остальной части не workspace
  dim_special = 0.5

  dim_around = 0.5

  border_part_of_window = false

  blur {
    enabled = true
    size = 2
    passes = 2
    ignore_opacity = false

    new_optimizations = true

    # активное окно показывает обои вместо приложения под ним
    xray = false

    # настройки блюра
    noise = 0.0
    contrast = 2.0
    brightness = 1
    vibrancy = 1
    vibrancy_darkness = 1

    # блюр сзади special workspace
    special = false
    # блюрить под контекстными меню
    popups = true
    popups_ignorealpha = 1

    # хз, что такое
    input_methods = false
    input_methods_ignorealpha = 1
  }

  shadow {
    enabled = true
    # дальность тени
    range = 50
    render_power = 5

    # отключает плавный блюр тени
    sharp = false
    ignore_window = false
    
    color = rgba(000000ff)
    color_inactive = rgba(000000ff)

    offset = 0, 0
    scale = 1
  }
}
